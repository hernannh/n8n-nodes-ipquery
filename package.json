{
  "name": "n8n-nodes-ipquery",
  "version": "0.1.0",
  "description": "Nodo community de n8n para ipquery.io: geolocalización y datos de IP (país, ciudad, ASN, ISP, flags de riesgo) por HTTPS, sin API key, con consulta en lote.",
  "keywords": [
    "n8n-community-node-package",
    "ipquery",
    "geoip",
    "geolocation",
    "enrichment",
    "threat-intel",
    "sockets-ar"
  ],
  "license": "MIT",
  "homepage": "https://git.sockets.ar/hernan/n8n-nodes-ipquery",
  "author": { "name": "Hernan", "email": "hernannh@gmail.com" },
  "repository": { "type": "git", "url": "https://git.sockets.ar/hernan/n8n-nodes-ipquery.git" },
  "engines": { "node": ">=20.15" },
  "main": "index.js",
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes --write",
    "lint": "eslint nodes package.json",
    "lintfix": "eslint nodes package.json --fix",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": ["dist/nodes/IpQuery/IpQuery.node.js"]
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  },
  "peerDependencies": { "n8n-workflow": "*" }
}
